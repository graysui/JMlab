# Use a fixed published version for predictable upgrades.
JMLAB_IMAGE=graysui/jmlab:v1.0.0
JMLAB_HOST_PORT=8097
JMLAB_ENV=production
JMLAB_PUBLIC_URL=http://localhost:8097
JMLAB_MASTER_KEY=replace-with-at-least-32-random-bytes
JMLAB_SESSION_SECRET=replace-with-at-least-32-random-bytes
# Optional: used only when creating the first Admin in an empty database.
JMLAB_BOOTSTRAP_ADMIN_USERNAME=admin
JMLAB_BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
