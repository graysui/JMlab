# JMlab Compose 配置示例。请复制为 .env 后替换所有密钥，不要把真实值提交到 Git。
JMLAB_MASTER_KEY=replace-with-at-least-32-random-bytes
JMLAB_SESSION_SECRET=replace-with-at-least-32-random-bytes
JMLAB_POSTGRES_PASSWORD=replace-with-a-postgres-password
# 首次启动且数据库没有用户时创建管理员；创建后可删除这两行。
JMLAB_BOOTSTRAP_ADMIN_USERNAME=admin
JMLAB_BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
